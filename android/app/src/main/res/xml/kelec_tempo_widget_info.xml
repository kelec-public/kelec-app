<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Tempo 4x2 (Glance) : voiture à gauche, Tempo à droite. Voir docs/native-android.md -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.kelec.widgets.WidgetConfigureActivity"
    android:description="@string/tempo_widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:previewLayout="@layout/tempo_widget_preview"
    android:previewImage="@drawable/example_appwidget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
